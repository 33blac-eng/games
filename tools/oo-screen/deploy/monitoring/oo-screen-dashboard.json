{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "title": "oo-screen hub",
  "uid": "oo-screen-hub",
  "tags": [
    "oo-screen"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(oo_hub_viewers, node)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_nodes"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Agents connected",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_agents"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Viewers",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(oo_hub_viewers)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 TTFF",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oo_hub_viewer_ttff_seconds_bucket[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "RSS",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_process_resident_memory_bytes"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Goroutines",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_goroutines"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Ingress bitrate vs target",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_agent_ingress_bps{node=~\"$node\"}",
          "legendFormat": "{{node}} ingress"
        },
        {
          "refId": "B",
          "expr": "oo_hub_bitrate_target_bps{node=~\"$node\"}",
          "legendFormat": "{{node}} target"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent FPS",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_agent_fps{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Viewer loss (max/avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_viewer_loss_fraction_max{node=~\"$node\"}",
          "legendFormat": "{{node}} max"
        },
        {
          "refId": "B",
          "expr": "oo_hub_viewer_loss_fraction_avg{node=~\"$node\"}",
          "legendFormat": "{{node}} avg"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Viewer RTT (max/avg)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_viewer_rtt_seconds_max{node=~\"$node\"}",
          "legendFormat": "{{node}} max"
        },
        {
          "refId": "B",
          "expr": "oo_hub_viewer_rtt_seconds_avg{node=~\"$node\"}",
          "legendFormat": "{{node}} avg"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Keyframes/min, viewer PLI/min",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_agent_keyframes_per_minute{node=~\"$node\"}",
          "legendFormat": "{{node}} kf/min"
        },
        {
          "refId": "B",
          "expr": "rate(oo_hub_viewer_pli_total{node=~\"$node\"}[$__rate_interval])*60",
          "legendFormat": "{{node}} PLI/min"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "NACK requested / retransmitted / unanswered",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "pps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(oo_hub_nack_requested_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} requested"
        },
        {
          "refId": "B",
          "expr": "rate(oo_hub_nack_retransmitted_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} rtx"
        },
        {
          "refId": "C",
          "expr": "rate(oo_hub_nack_unanswered_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} unanswered"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Time to first frame",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(oo_hub_viewer_ttff_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(oo_hub_viewer_ttff_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Queues: egress depth, viewer drops",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_egress_queue_depth",
          "legendFormat": "egress depth"
        },
        {
          "refId": "B",
          "expr": "rate(oo_hub_egress_queue_full_total[$__rate_interval])",
          "legendFormat": "egress full/s"
        },
        {
          "refId": "C",
          "expr": "rate(oo_hub_viewer_queue_drops_total{node=~\"$node\"}[$__rate_interval])",
          "legendFormat": "{{node}} viewer drops/s"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "GOP cache",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_gop_cache_bytes{node=~\"$node\"}",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Hub memory",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 36,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "oo_hub_process_resident_memory_bytes",
          "legendFormat": "RSS"
        },
        {
          "refId": "B",
          "expr": "oo_hub_heap_alloc_bytes",
          "legendFormat": "heap alloc"
        }
      ]
    }
  ]
}
